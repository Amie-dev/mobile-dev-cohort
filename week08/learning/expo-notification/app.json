{
  "expo": {
    "name": "expo-notification",
    "slug": "expo-notification",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "exponotification",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amie.code.exponotification",
      "googleServicesFile": "google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-notifications"
    ],
    "notification": {
      "icon": "./assets/images/notification_icon.png",
      "color": "#ffffff",
      "defaultChannel": "default",
      "sounds": [
        "./assets/notification_sound.mp3",
        "./assets/notification_sound_other.mp3",
        "./assets/universfield-new-notification-051-494246.mp3"
      ],
      "enableBackgroundRemoteNotifications": true
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5118e07f-5c9f-4f89-8209-0f967173aa93"
      }
    },
    "owner": "amie.code"
  }
}
